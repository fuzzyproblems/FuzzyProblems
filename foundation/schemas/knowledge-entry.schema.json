{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-entry",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "explanation",
    "authors",
    "objective_links",
    "support",
    "qualifications",
    "disagreements",
    "limitations",
    "status",
    "dependencies",
    "review",
    "authoring_models"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objective_links": {
      "type": "array",
      "minItems": 1
    },
    "support": {
      "type": "array",
      "minItems": 1
    },
    "qualifications": {
      "type": "array"
    },
    "disagreements": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "status": {
      "enum": [
        "candidate",
        "supported",
        "reviewed",
        "gap",
        "stale"
      ]
    },
    "dependencies": {
      "type": "object",
      "required": [
        "sources",
        "specification_sha256"
      ],
      "properties": {},
      "oneOf": [
        {
          "required": [
            "objective_register_sha256"
          ]
        },
        {
          "required": [
            "curriculum",
            "source_records"
          ]
        }
      ]
    },
    "review": {
      "type": [
        "string",
        "null"
      ]
    },
    "authoring_models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "model",
          "reasoning",
          "configuration_check"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reasoning": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "configuration_check": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
